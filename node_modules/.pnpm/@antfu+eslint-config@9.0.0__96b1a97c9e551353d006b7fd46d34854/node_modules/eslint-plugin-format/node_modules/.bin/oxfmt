fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../oxfmt@0.35.0/node_modules/oxfmt/bin/oxfmt" "$@"
else
  exec node  "$basedir/../../../../../oxfmt@0.35.0/node_modules/oxfmt/bin/oxfmt" "$@"
