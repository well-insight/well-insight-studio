NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5181

DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=well_design
DB_USER=well_admin
DB_PASSWORD=replace-me
DB_SSL=false
DB_CONNECTION_LIMIT=5

# 数据源连接串加密密钥（32 字节 hex）；未配置时明文存储
DS_ENCRYPTION_KEY=replace-with-64-char-hex-key

# JWT 配置
JWT_SECRET=replace-with-random-secret-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d
