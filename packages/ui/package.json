{
  "name": "@well-design/ui",
  "version": "0.1.1",
  "description": "Vue 3 component library for Well Design.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "development": "./src/styles/index.css",
      "default": "./dist/styles.css"
    },
    "./docs": "./src/docs/index.ts"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build:docs": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "release": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-markdown-preview": "^1.1.1",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9"
  }
}
