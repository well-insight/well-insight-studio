{
  "name": "@well-design/ui",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./docs": "./src/docs/index.ts"
  },
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build:docs": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@well-design/theme": "workspace:*",
    "vue": "^3.5.41",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.2",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.2.1",
    "vite-plugin-markdown-preview": "^1.1.1",
    "vitest": "^4.1.10",
    "vue-router": "^5.2.0",
    "vue-tsc": "^3.3.9"
  }
}
