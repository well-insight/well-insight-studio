{
  "compilerOptions": {
    "incremental": true,
    "target": "ESNext",
    "jsx": "preserve",
    "lib": ["es6", "ESNext", "dom"],
    "module": "ESNext", // 建议配合 ESNext 使用
    "moduleResolution": "bundler", // 替换原来的 "node" 或其他值
    "paths": {
      "@/*": ["./src/*"],
      "/#/*": ["./types/*"]
    },
    "resolveJsonModule": true,
    // "typeRoots": ["./node_modules/@types/", "./types"],
    "types": ["vite/client", "node", "element-plus/global"],
    // 增加类型实例化深度
    "maxNodeModuleJsDepth": 2,
    // 关闭严格检查
    "strict": false,
    "strictFunctionTypes": false,
    "strictNullChecks": false,
    "noImplicitAny": true, // 不允许使用any
    // "strictNullChecks": true, //不允许使用null
    "noImplicitThis": true, // 不允许往this上面挂属性
    "sourceMap": true,
    "esModuleInterop": true, // 确保开启，兼容 CommonJS 模块
    "skipLibCheck": true // 可选，跳过库文件的类型检查，避免额外报错
  },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.d.ts",
    "./src/**/*.tsx",
    "./src/**/*.vue",
    "./types/**/*",
    "./src/api/mock/vchart/bar.js"
  ],
  "exclude": ["./node_modules", "./dist", "**/*.js"]
}
