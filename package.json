{
  "name": "well-design",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @well-design/api --filter @well-design/web --filter @well-design/ui run dev",
    "dev:web": "pnpm --filter @well-design/web dev",
    "dev:ui": "pnpm --filter @well-design/ui dev",
    "dev:api": "pnpm --filter @well-design/api dev",
    "build": "pnpm --filter @well-design/ui build && pnpm --filter @well-design/shared --filter @well-design/web --filter @well-design/api run build",
    "build:ui": "pnpm --filter @well-design/ui build",
    "build:ui:docs": "pnpm --filter @well-design/ui build:docs",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build:ui && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3"
    }
  }
}
