{
  "name": "well-insight-studio",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --parallel --filter @well-insight/api --filter @well-insight/web run dev",
    "dev:web": "pnpm --filter @well-insight/web dev",
    "dev:api": "pnpm --filter @well-insight/api dev",
    "build": "pnpm --filter @well-insight/shared --filter @well-insight/web --filter @well-insight/api run build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "typescript": "5.9.3"
    }
  }
}
